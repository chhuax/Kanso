{
  "sourceLanguage" : "en",
  "strings" : {
    "Every action an AI tool takes through MCP is recorded here. Records stay on this Mac for 30 days." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Every action an AI tool takes through MCP is recorded here. Records stay on this Mac for 30 days." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 工具通过 MCP 进行的每次操作都记在这里，只保存在本机，保留 30 天。" } }
      }
    },
    "Activity log changed — Reload" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Activity log changed — Reload" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "活动记录有变化，点击刷新" } }
      }
    },
    "MCP Activity" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "MCP Activity" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "MCP 活动记录" } }
      }
    },
    "Clear the MCP activity log?" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear the MCP activity log?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空 MCP 活动记录？" } }
      }
    },
    "All records of what AI tools did through MCP will be deleted. This can’t be undone." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "All records of what AI tools did through MCP will be deleted. This can’t be undone." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 工具通过 MCP 进行操作的所有记录都会被删除，此操作无法撤销。" } }
      }
    },
    "Could not read the audit log: %@" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not read the audit log: %@" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取活动记录：%@" } }
