      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Activity Log" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开活动记录" } }
      }
    },
    "When on, AI tools on this Mac can access the sessions you have opened to them." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When on, AI tools on this Mac can access the sessions you have opened to them." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启后，本机的 AI 工具可以访问你已对其开放的会话。" } }
      }
    },
    "No sessions are open to AI tools yet." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No sessions are open to AI tools yet." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有对 AI 工具开放任何会话。" } }
      }
    },
    "1 session is open to AI tools. Change this from a session’s … menu or its editor." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "1 session is open to AI tools. Change this from a session’s … menu or its editor." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有 1 个会话对 AI 工具开放。可在会话的“…”菜单或会话编辑对话框中修改。" } }
      }
    },
    "%lld sessions are open to AI tools. Change this from a session’s … menu or its editor." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld sessions are open to AI tools. Change this from a session’s … menu or its editor." } },
