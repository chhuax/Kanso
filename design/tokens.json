{
  "version": 1,
  "color": {
    "bg.window": { "light": "#F6F6F3", "dark": "#050505", "note": "主窗口背景，分屏区与终端周围的底色" },
    "bg.sidebar": { "light": "#ECECE8", "dark": "#0B0B0B", "note": "竖向标签栏背景的不透明基色；实际显示叠加系统毛玻璃材质，此值用于对比度计算与无材质时的回退" },
    "bg.tabHover": { "light": "#E2E2DD", "dark": "#161616", "note": "标签行悬停背景" },
    "bg.tabSelected": { "light": "#FFFFFF", "dark": "#212121", "note": "选中标签行背景" },
    "bg.panel": { "light": "#FAFAF8", "dark": "#0F0F0F", "note": "Filer、Sender 等面板背景" },
    "bg.statusBar": { "light": "#EAEAE5", "dark": "#0B0B0B", "note": "底部状态栏背景" },
    "bg.popover": { "light": "#FFFFFF", "dark": "#151515", "note": "弹出菜单、命令面板、会话启动器、提示气泡背景" },
    "border.subtle": { "light": "#DEDED8", "dark": "#2A2A2A", "note": "面板之间的细分隔线" },
    "border.strong": { "light": "#BFBFB7", "dark": "#424242", "note": "浮层（启动器、对话框外壳）与次要按钮的明确轮廓" },
    "bg.dialog": { "light": "#F3F3EF", "dark": "#181818", "note": "对话框外壳背景（visual-style §3.3）" },
    "bg.card": { "light": "#FBFBF9", "dark": "#151515", "note": "对话框内分区卡片背景" },
    "border.card": { "light": "#E0E0DA", "dark": "#202020", "note": "分区卡片的 1px 边框" },
    "bg.field": { "light": "#FFFFFF", "dark": "#0F0F0F", "note": "输入框、下拉框背景（实色）" },
    "border.field": { "light": "#D2D2CC", "dark": "#1E1E1E", "note": "输入框、下拉框的 1px 边框；获得焦点时换成 accent" },
    "bg.buttonSecondary": { "light": "#FFFFFF", "dark": "#2A2A2A", "note": "次要按钮底色" },
    "bg.segmentSelected": { "light": "#DCEFF4", "dark": "#1E333B", "note": "选中的分段卡片底色（强调色的低明度版本）" },
    "border.segmentSelected": { "light": "#0A7C98", "dark": "#1A8EAB", "note": "选中的分段卡片边框" },
    "bg.rowHover": { "light": "#EDEDE8", "dark": "#1F1F1F", "note": "启动器会话行等列表行的悬停高亮" },
    "bg.scrim": { "light": "#00000033", "dark": "#00000080", "note": "对话框后面的半透明遮罩，半透明" },
    "text.primary": { "light": "#1B1D20", "dark": "#F2F2F2", "note": "主要文字，如标签主标题、正文" },
    "text.secondary": { "light": "#4D5258", "dark": "#8A8A8A", "note": "次要文字，如标签副标题、说明" },
    "text.tertiary": { "light": "#767B82", "dark": "#6A6A6A", "note": "占位符、禁用项等弱化文字；对比度只要求 3:1，不得用于承载必要信息" },
    "text.onAccent": { "light": "#FFFFFF", "dark": "#031018", "note": "强调色底上的文字，如主按钮文字" },
    "accent": { "light": "#0A7C98", "dark": "#15B8E0", "note": "强调色（青色）：焦点输入框边框、选中态、主按钮底色、链接" },
    "status.running": { "light": "#1F7A8C", "dark": "#4FB8CC", "note": "命令正在运行" },
    "status.unreadDone": { "light": "#2D7D46", "dark": "#58C47A", "note": "后台标签有已完成但未查看的输出" },
    "status.agentRunning": { "light": "#7447B8", "dark": "#B393F0", "note": "AI agent 运行中" },
    "agent.claude": { "light": "#B85A36", "dark": "#D97757", "note": "Claude Code 标签图标的品牌色" },
    "agent.gemini": { "light": "#2F6FD6", "dark": "#6AA0F2", "note": "Gemini CLI 标签图标的品牌色" },
    "agent.qwen": { "light": "#4F48D9", "dark": "#8F8BF7", "note": "Qwen Code 标签图标的品牌色" },
    "status.error": { "light": "#C0322B", "dark": "#F07268", "note": "错误、失败" },
    "status.warning": { "light": "#A9620A", "dark": "#E0A24A", "note": "警告、需要注意" },
    "status.legacySsh": { "light": "#B5530F", "dark": "#EE9C5A", "note": "状态栏 Legacy SSH 提示：连接用了旧算法" },
    "status.disconnected": { "light": "#707680", "dark": "#8A9099", "note": "连接已断开或会话已结束" },
    "diff.added": { "light": "#1E7F3F", "dark": "#62CB82", "note": "diff 与 git 统计中的新增" },
    "diff.removed": { "light": "#B8322C", "dark": "#F27D74", "note": "diff 与 git 统计中的删除" },
    "diff.addedBackground": { "light": "#E6F4E9", "dark": "#142B1C", "note": "差异新增行整行底色" },
    "diff.removedBackground": { "light": "#FBE9E7", "dark": "#341D1C", "note": "差异删除行整行底色" },
    "diff.addedHighlight": { "light": "#B9E4C4", "dark": "#275C38", "note": "差异新增行内变化底色" },
    "diff.removedHighlight": { "light": "#F2C1BC", "dark": "#713530", "note": "差异删除行内变化底色" },
    "diff.badgeBackground": { "light": "#E2E6DF", "dark": "#242924", "note": "文件增删统计胶囊底色" },
    "terminal.commandSeparator": { "light": "#1B1D2026", "dark": "#ECEDEF26", "note": "命令之间的分隔线，半透明，叠在终端背景上" },
    "terminal.gutterText": { "light": "#6A6F76", "dark": "#8E949B", "note": "时间戳栏文字，显示在终端背景上" },
    "terminal.gutterCursorLine": { "light": "#2A6A8A1F", "dark": "#62B0D226", "note": "时间戳栏中光标所在行的高亮底色，半透明" },
    "terminal.chipBackground": { "light": "#F5F5F0", "dark": "#25282C", "note": "提示符上下文标签的浅底色" },
    "terminal.chipBorder": { "light": "#C9CDC5", "dark": "#4B5158", "note": "提示符上下文标签的细边框" }
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "tabRow.height": 44,
    "tabRow.paddingX": 10,
    "sidebar.defaultWidth": 240,
    "sidebar.minWidth": 160,
    "statusBar.height": 24,
    "field.height": 30,
    "field.paddingX": 10
  },
  "radius": {
    "sm": 4,
    "md": 6,
    "lg": 10,
    "tabRow": 8,
    "xl": 12
  },
  "font": {
    "ui.body": 13,
    "ui.caption": 11,
    "ui.tabTitle": 13,
    "ui.tabSubtitle": 11,
    "ui.title": 15,
    "terminal.default": 13
  },
  "contrast": [
    { "fg": "text.primary", "bg": "bg.window", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.sidebar", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.tabSelected", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.panel", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.popover", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.window", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.sidebar", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.tabSelected", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.panel", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.popover", "min": 4.5 },
    { "fg": "text.tertiary", "bg": "bg.window", "min": 3.0 },
    { "fg": "text.onAccent", "bg": "accent", "min": 4.5 },
    { "fg": "status.running", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "status.unreadDone", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "status.agentRunning", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "agent.claude", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "agent.gemini", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "agent.qwen", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "status.error", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "status.warning", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "status.legacySsh", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "status.disconnected", "bg": "bg.sidebar", "min": 3.0 },
    { "fg": "text.primary", "bg": "bg.dialog", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.dialog", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.card", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.card", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.field", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.field", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.rowHover", "min": 4.5 },
    { "fg": "text.secondary", "bg": "bg.rowHover", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.buttonSecondary", "min": 4.5 },
    { "fg": "text.primary", "bg": "bg.segmentSelected", "min": 4.5 },
    { "fg": "text.tertiary", "bg": "bg.field", "min": 3.0 },
    { "fg": "accent", "bg": "bg.field", "min": 3.0 },
    { "fg": "accent", "bg": "bg.card", "min": 3.0 },
    { "fg": "accent", "bg": "bg.dialog", "min": 3.0 },
    { "fg": "border.segmentSelected", "bg": "bg.card", "min": 3.0 },
    { "fg": "status.error", "bg": "bg.dialog", "min": 4.5 },
    { "fg": "status.error", "bg": "bg.card", "min": 4.5 }
  ]
}
