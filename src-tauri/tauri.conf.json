{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZenTerm",
  "version": "../package.json",
  "identifier": "com.zenterm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZenTerm",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#181818"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Lightweight terminal, SSH, FTP and serial client built with Rust (installer under 5 MB)",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzQkI2OTcxQzI3QjE1MkYKUldRdkZYdkNjV203MDV1TGsyMXplU2tyb2VZUzl0bEpMOFlWeWZzVCtsQ2tFeGkrNkpkZ29VRDUK",
      "endpoints": [
        "http://10.66.0.60:3000/huaxin/ZenTerm/releases/download/latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
